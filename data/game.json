    { "id": "act2-theft", "name": "驻防计划", "description": "潜入北区指挥部，偷取驻防计划交给皮埃尔。", "hint": "指挥部北区，需要找到入口。", "objectives": [{ "type": "ReachMarker", "target": ">", "count": 1 }], "rewards": [{ "type": "Currency", "amount": 50 }] },
    { "id": "act2-warning", "name": "紧急情报", "description": "占领军即将发动大规模扫荡！必须尽快通知反抗军。", "hint": "雷诺队长在东边山区。", "objectives": [{ "type": "TalkToNpc", "target": "CapitaineRenaud", "count": 1 }], "rewards": [{ "type": "Currency", "amount": 35 }] },
    { "id": "act2-allies-plan", "name": "盟军的计划", "description": "盟军需要从后方摧毁占领军指挥部。与雷诺队长商讨具体方案。", "hint": "雷诺队长在东边山区营地。", "objectives": [{ "type": "TalkToNpc", "target": "CapitaineRenaud", "count": 1 }], "rewards": [{ "type": "Currency", "amount": 30 }] },
    { "id": "act2-raid", "name": "截获运输队", "description": "与维克多合作，截获占领军的运输车队。", "hint": "运输队从北边公路经过。", "objectives": [{ "type": "KillEnemy", "target": "Occupier", "count": 2 }], "rewards": [{ "type": "Currency", "amount": 60 }] },
    { "id": "act2-gold-vault", "name": "金库劫案", "description": "帮维克多从占领军指挥部地下金库偷取黄金。", "hint": "金库在指挥部地下。", "objectives": [{ "type": "ReachMarker", "target": ">", "count": 1 }], "rewards": [{ "type": "Currency", "amount": 100 }] },
    { "id": "act3-destroy-comm", "name": "摧毁通讯塔", "description": "摧毁占领军的通讯塔，切断他们和总部的联系。", "hint": "通讯塔在北区指挥部东侧。", "objectives": [{ "type": "KillEnemy", "target": "Officer", "count": 2 }], "rewards": [{ "type": "Currency", "amount": 80 }] },
    { "id": "act3-destroy-hq", "name": "摧毁指挥部", "description": "摧毁占领军指挥部，为盟军扫清障碍。这是最终决战。", "hint": "指挥部在北区，重兵把守。", "objectives": [{ "type": "KillEnemy", "target": "Officer", "count": 3 }, { "type": "KillEnemy", "target": "Occupier", "count": 5 }], "rewards": [{ "type": "Currency", "amount": 150 }] },
