    { "id": "act1-meet-renaud", "name": "会见雷诺队长", "description": "前往东边山区的反抗军营地，与雷诺队长取得联系。", "hint": "从教堂后门出去，沿山路向东走。", "objectives": [{ "type": "TalkToNpc", "target": "CapitaineRenaud", "count": 1 }], "rewards": [{ "type": "Currency", "amount": 20 }, { "type": "Item", "target": "Bandage", "amount": 3 }] },
    { "id": "act1-infiltrate", "name": "渗透傀儡政权", "description": "穆勒上尉让你监视傀儡政权的联络官皮埃尔。", "hint": "皮埃尔在市政厅附近。", "objectives": [{ "type": "TalkToNpc", "target": "Pierre", "count": 1 }], "rewards": [{ "type": "Currency", "amount": 30 }] },
    { "id": "act2-double-agent", "name": "双面间谍", "description": "你同时为占领军和反抗军效力。在两方之间周旋。", "hint": "注意不要暴露身份。", "objectives": [{ "type": "TalkToNpc", "target": "CapitaineRenaud", "count": 1 }, { "type": "TalkToNpc", "target": "HauptmannMueller", "count": 1 }], "rewards": [{ "type": "Currency", "amount": 50 }] },
