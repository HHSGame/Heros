    { "id": "act3-contact-allies", "name": "联络盟军", "description": "穿越前线，联络盟军指挥部，请求他们在总攻时从南面夹击。", "hint": "盟军在南边前线。", "objectives": [{ "type": "ReachMarker", "target": "<", "count": 1 }], "rewards": [{ "type": "Currency", "amount": 50 }] }
