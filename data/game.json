  "dialogues": [
    {
      "id": "fixer-dialogue",
      "startNodeId": "start",
      "nodes": [
        {
          "id": "start",
          "text": "Need supplies? Bring me a health potion and I will pay.",
          "options": [
            {
              "text": "I'll handle it.",
              "nextNodeId": "accept",
              "effects": [
                {
                  "type": "StartQuest",
                  "target": "missing-supply"
                }
              ]
            },
            {
              "text": "Pay me more for this.",
              "nextNodeId": "accept",
              "requirements": [
                {
                  "type": "Skill",
                  "id": "Barter",
                  "min": 4
                }
              ],
              "effects": [
                {
                  "type": "StartQuest",
                  "target": "missing-supply"
                },
                {
                  "type": "AddCurrency",
                  "amount": 10
                }
              ]
            },
            {
              "text": "I can solve it with knowledge.",
              "nextNodeId": "complete",
              "requirements": [
                {
                  "type": "Skill",
                  "id": "Knowledge",
                  "min": 10
                }
              ],
              "effects": [
                {
                  "type": "StartQuest",
                  "target": "missing-supply"
                },
                {
                  "type": "GiveItem",
                  "target": "HealthPotion",
                  "amount": 1
                },
                {
                  "type": "CompleteQuest",
                  "target": "missing-supply"
                }
              ]
            },
            {
              "text": "Something feels off about this.",
              "nextNodeId": "suspicious",
              "requirements": [
                {
                  "type": "Skill",
                  "id": "Awareness",
                  "min": 8
                },
                {
                  "type": "QuestStatus",
                  "id": "missing-supply",
                  "status": "Inactive"
                }
              ]
            },
            {
              "text": "I'll deal with the bandit.",
              "nextNodeId": "hunt",
              "effects": [
                {
                  "type": "StartQuest",
                  "target": "bandit-hunt"
                }
              ]
            },
            {
              "text": "I brought the potion.",
              "nextNodeId": "complete",
              "effects": [
                {
                  "type": "CompleteQuest",
                  "target": "missing-supply"
                }
              ]
            },
            {
              "text": "The bandit is gone.",
              "nextNodeId": "bandit-complete",
              "effects": [
                {
                  "type": "CompleteQuest",
                  "target": "bandit-hunt"
                }
              ]
            },
            {
              "text": "Thanks again for your help.",
              "nextNodeId": "praise",
              "requirements": [
                {
                  "type": "QuestStatus",
                  "id": "missing-supply",
                  "status": "Completed"
                }
              ]
            },
            {
              "text": "You made the area safer.",
              "nextNodeId": "praise",
              "requirements": [
                {
                  "type": "QuestStatus",
                  "id": "bandit-hunt",
                  "status": "Completed"
                }
              ]
            },
            {
              "text": "Maybe later.",
              "nextNodeId": ""
            }
          ]
        },
        {
          "id": "accept",
          "text": "Come back with the potion.",
          "options": [
            {
              "text": "Got it.",
              "nextNodeId": ""
            }
          ]
        },
        {
          "id": "suspicious",
          "text": "You have sharp eyes. Still want the job?",
          "options": [
            {
              "text": "Fine, I'll help.",
              "nextNodeId": "accept",
              "effects": [
                {
                  "type": "StartQuest",
                  "target": "missing-supply"
                }
              ]
            },
            {
              "text": "No deal.",
              "nextNodeId": ""
            }
          ]
        },
        {
          "id": "hunt",
          "text": "A bandit is lurking east of here. Take care of it.",
          "options": [
            {
              "text": "On it.",
              "nextNodeId": ""
            }
          ]
        },
        {
          "id": "complete",
          "text": "Impressive. Here's your reward.",
          "options": [
            {
              "text": "Thanks.",
              "nextNodeId": ""
            }
          ]
        },
        {
          "id": "bandit-complete",
          "text": "Good work. The area feels safer now.",
          "options": [
            {
              "text": "Glad to help.",
              "nextNodeId": ""
            }
          ]
        },
        {
          "id": "praise",
          "text": "Good to see you again.",
          "options": [
            {
              "text": "Take care.",
              "nextNodeId": ""
            }
          ]
        }
      ]
    },
    {
      "id": "scholar-dialogue",
      "startNodeId": "start",
      "nodes": [
        {
          "id": "start",
          "text": "I need someone to reach the marker and report back.",
          "options": [
            {
              "text": "I'll scout it.",
              "nextNodeId": "accept",
              "effects": [
                {
                  "type": "StartQuest",
                  "target": "scout-marker"
                }
              ]
            },
            {
              "text": "Share your notes first.",
              "nextNodeId": "accept",
              "requirements": [
                {
                  "type": "Skill",
                  "id": "Persuasion",
                  "min": 5
                }
              ],
              "effects": [
                {
                  "type": "StartQuest",
                  "target": "scout-marker"
                },
                {
                  "type": "AddCurrency",
                  "amount": 5
                }
              ]
            },
            {
              "text": "I've reached the marker.",
              "nextNodeId": "report",
              "effects": [
                {
                  "type": "CompleteQuest",
                  "target": "scout-marker"
                }
              ]
            },
            {
              "text": "Good to see you again.",
              "nextNodeId": "praise",
              "requirements": [
                {
                  "type": "QuestStatus",
                  "id": "scout-marker",
                  "status": "Completed"
                }
              ]
            },
            {
              "text": "Goodbye.",
              "nextNodeId": ""
            }
          ]
        },
        {
          "id": "accept",
          "text": "Return when you've reached the marker.",
          "options": [
            {
              "text": "Understood.",
              "nextNodeId": ""
            }
          ]
        },
        {
          "id": "report",
          "text": "Excellent. Here's your payment.",
          "options": [
            {
              "text": "Happy to help.",
              "nextNodeId": ""
            }
          ]
        },
        {
          "id": "praise",
          "text": "Your help is appreciated.",
          "options": [
            {
              "text": "Anytime.",
              "nextNodeId": ""
            }
          ]
        }
      ]
    }
