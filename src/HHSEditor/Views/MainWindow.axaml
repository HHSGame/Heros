<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HHSEditor.ViewModels"
        xmlns:views="using:HHSEditor.Views"
        x:Class="HHSEditor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="HHS Game Editor"
        Width="1200"
        Height="800"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Project" />
                <MenuItem Header="_Open Project" />
                <MenuItem Header="_Save" />
                <Separator />
                <MenuItem Header="E_xit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" />
                <MenuItem Header="_Redo" />
                <Separator />
                <MenuItem Header="Cu_t" />
                <MenuItem Header="_Copy" />
                <MenuItem Header="_Paste" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Map Editor" />
                <MenuItem Header="_Catalog Editor" />
                <MenuItem Header="_Enemy Editor" />
                <MenuItem Header="_Dialogue Editor" />
                <MenuItem Header="_Quest Editor" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" />
            </MenuItem>
        </Menu>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom" Background="#F0F0F0" Padding="4">
            <TextBlock Text="{Binding StatusMessage}" />
        </Border>

        <!-- Main Content -->
        <TabControl>
            <TabItem Header="Catalog Editor">
                <views:CatalogEditorView />
            </TabItem>
            <TabItem Header="Enemy Editor">
                <views:EnemyEditorView />
            </TabItem>
            <TabItem Header="Map Editor">
                <TextBlock Text="Map Editor - Coming Soon" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" />
            </TabItem>
            <TabItem Header="Dialogue Editor">
                <TextBlock Text="Dialogue Editor - Coming Soon" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" />
            </TabItem>
            <TabItem Header="Quest Editor">
                <TextBlock Text="Quest Editor - Coming Soon" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
