<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HHSEditor.ViewModels"
             xmlns:controls="using:HHSEditor.Controls"
             x:Class="HHSEditor.Views.QuestEditorView"
             x:DataType="vm:QuestEditorViewModel">

    <DockPanel>
        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
            <Button Content="Load" Command="{Binding LoadDataCommand}" Margin="2" />
            <Button Content="Save" Command="{Binding SaveDataCommand}" Margin="2" />
            <Button Content="Add Quest" Command="{Binding AddQuestCommand}" Margin="2" />
            <Button Content="Remove Quest" Command="{Binding RemoveQuestCommand}" Margin="2" />
        </StackPanel>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom" Background="#E8E8E8" Padding="4">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" />
        </Border>

        <!-- Main Content -->
        <TabControl>
            <!-- Quest List View -->
            <TabItem Header="Quest List">
                <Grid ColumnDefinitions="250,*">
                    <!-- Quest List -->
                    <DockPanel Grid.Column="0">
                        <TextBlock Text="Quests" FontWeight="Bold" Margin="4" DockPanel.Dock="Top" />
                        <ListBox ItemsSource="{Binding Quests}"
                                 SelectedItem="{Binding SelectedQuest}"
                                 Margin="4">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Id}" FontSize="11" Foreground="Gray" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- Quest Details -->
                    <ScrollViewer Grid.Column="1" Margin="4">
                        <StackPanel DataContext="{Binding SelectedQuest}">
                            <TextBlock Text="Quest Details" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />

                            <TextBlock Text="ID:" />
                            <TextBox Text="{Binding Id}" IsReadOnly="True" Margin="0,0,0,4" />

                            <TextBlock Text="Name:" />
                            <TextBox Text="{Binding Name}" Margin="0,0,0,4" />

                            <TextBlock Text="Description:" />
                            <TextBox Text="{Binding Description}" AcceptsReturn="True" MinHeight="60" Margin="0,0,0,4" />

                            <TextBlock Text="Hint:" />
                            <TextBox Text="{Binding Hint}" Margin="0,0,0,8" />

                            <!-- Objectives -->
                            <TextBlock Text="Objectives" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Objectives}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="LightGreen" BorderThickness="2" Margin="0,4" Padding="8" CornerRadius="4">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="Kind:" Width="80" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Kind}" FontWeight="Bold" />
                                                </DockPanel>
                                                <DockPanel>
                                                    <TextBlock Text="Target:" Width="80" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding TargetId}" />
                                                </DockPanel>
                                                <DockPanel>
                                                    <TextBlock Text="Count:" Width="80" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding RequiredCount}" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Rewards -->
                            <TextBlock Text="Rewards" FontWeight="Bold" FontSize="14" Margin="0,8,0,4" />
                            <ItemsControl ItemsSource="{Binding Rewards}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="Gold" BorderThickness="2" Margin="0,4" Padding="8" CornerRadius="4">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="Kind:" Width="80" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Kind}" FontWeight="Bold" />
                                                </DockPanel>
                                                <DockPanel>
                                                    <TextBlock Text="Target:" Width="80" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding TargetId}" />
                                                </DockPanel>
                                                <DockPanel>
                                                    <TextBlock Text="Amount:" Width="80" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Amount}" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Story Graph View -->
            <TabItem Header="Story Graph">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Quest Story Graph" FontWeight="Bold" Margin="4" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <controls:QuestGraphControl Nodes="{Binding GraphNodes}" />
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Stats Tab -->
            <TabItem Header="Stats">
                <StackPanel Margin="8">
                    <TextBlock Text="Quest Statistics" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />
                    <TextBlock Text="Total Quests:" FontWeight="Bold" />
                    <TextBlock Text="{Binding Quests.Count}" Margin="0,0,0,8" />

                    <TextBlock Text="Quest List" FontWeight="Bold" Margin="0,8,0,4" />
                    <ItemsControl ItemsSource="{Binding Quests}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="{Binding Id}" Width="150" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Name}" Width="200" />
                                    <TextBlock Text="{Binding Description}" MaxWidth="300" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
